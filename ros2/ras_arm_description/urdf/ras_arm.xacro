<?xml version="1.0"?>
<!-- The ras-arm: 6 revolute joints + 2 finger slides, with the firmware's joint names, signs and zero
     (docs/kinematics.md): a joint position here is the firmware angle in rad, a finger is the grip
     opening / 2 in m. Zero pose = everything straight up, facing +x.
     Numbers: config/arm.yaml (generated from config.h), hardware.yaml (datasheets), cad.yaml (offsets,
     colours), cad_meshes.yaml (generated by tools/cad_import.py: meshes + mass properties). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="arm" value="${xacro.load_yaml('$(find ras_arm_description)/config/arm.yaml')}"/>
  <xacro:property name="hw" value="${xacro.load_yaml('$(find ras_arm_description)/config/hardware.yaml')}"/>
  <xacro:property name="cad" value="${xacro.load_yaml('$(find ras_arm_description)/config/cad.yaml')}"/>
  <xacro:property name="meshes" value="${xacro.load_yaml('$(find ras_arm_description)/config/cad_meshes.yaml')['links']}"/>
  <xacro:property name="H" value="${arm['geometry']['h_shoulder']}"/>
  <xacro:property name="L1" value="${arm['geometry']['l1']}"/>
  <xacro:property name="L2" value="${arm['geometry']['l2']}"/>
  <xacro:property name="L3" value="${arm['geometry']['l3']}"/>
  <xacro:property name="d4" value="${cad['offsets']['d4']}"/>
  <xacro:property name="d6" value="${cad['offsets']['d6']}"/>
  <xacro:property name="FINGER" value="0.044"/>              <!-- finger length (placeholder) -->
  <!-- how far the fingertips reach past the firmware's tip (the grasp point, CELL_GRIP_Z = 24 mm when
       picking): the pads close on the cube's top 8 mm, above the 16 mm cradle walls (placeholder) -->
  <xacro:property name="BEYOND" value="0.007"/>
  <xacro:property name="FZ" value="${BEYOND - FINGER / 2}"/>  <!-- finger centre, from the tip -->

  <material name="orange"><color rgba="0.89 0.64 0.23 1"/></material>
  <material name="dark"><color rgba="0.20 0.23 0.28 1"/></material>
  <material name="grey"><color rgba="0.54 0.58 0.64 1"/></material>
  <material name="light"><color rgba="0.79 0.81 0.84 1"/></material>

  <!-- visuals: the CAD mesh when there is one (exported in the zero pose, in mm, so it is moved back by
       the link's zero-pose position y0, z0), else the placeholder shapes -->
  <xacro:macro name="looks" params="name z0 y0:=0 **placeholder">
    <xacro:if value="${name in meshes}">
      <visual>
        <origin xyz="0 ${-y0} ${-z0}"/>
        <geometry><mesh filename="package://ras_arm_description/meshes/${meshes[name]['mesh']}" scale="0.001 0.001 0.001"/></geometry>
        <material name="${cad['materials'][name]}"/>
      </visual>
    </xacro:if>
    <xacro:unless value="${name in meshes}">
      <xacro:insert_block name="placeholder"/>
    </xacro:unless>
  </xacro:macro>

  <!-- inertia: from the CAD shape when imported (mass from hardware.yaml, spread like the real parts),
       else a solid box m, x × y × z centred at xyz -->
  <xacro:macro name="box_inertial" params="m x y z xyz name:=''">
    <xacro:if value="${name in meshes}">
      <xacro:property name="c" value="${meshes[name]}"/>
      <inertial>
        <origin xyz="${c['com'][0]} ${c['com'][1]} ${c['com'][2]}"/>
        <mass value="${c['mass']}"/>
        <inertia ixx="${c['inertia'][0]}" iyy="${c['inertia'][1]}" izz="${c['inertia'][2]}"
                 ixy="${c['inertia'][3]}" ixz="${c['inertia'][4]}" iyz="${c['inertia'][5]}"/>
      </inertial>
    </xacro:if>
    <xacro:unless value="${name in meshes}">
      <inertial>
        <origin xyz="${xyz}"/>
        <mass value="${m}"/>
        <inertia ixx="${m * (y * y + z * z) / 12}" ixy="0" ixz="0" iyy="${m * (x * x + z * z) / 12}" iyz="0" izz="${m * (x * x + y * y) / 12}"/>
      </inertial>
    </xacro:unless>
  </xacro:macro>

  <xacro:macro name="revolute" params="name parent child xyz axis">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}"/>
      <axis xyz="${axis}"/>
      <limit lower="${arm['joints'][name]['lower']}" upper="${arm['joints'][name]['upper']}"
             velocity="${arm['joints'][name]['velocity']}" effort="${hw['effort'][name]}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="finger" params="side sign">
    <link name="finger_${side}">
      <xacro:looks name="finger_${side}" y0="${sign * cad['offsets']['export_opening'] / 2}" z0="${H + L1 + L2 + L3}">
        <placeholder>
          <visual><origin xyz="0 ${sign * 0.004} ${FZ}"/><geometry><box size="0.014 0.008 ${FINGER}"/></geometry><material name="light"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 ${sign * 0.004} ${FZ}"/><geometry><box size="0.014 0.008 ${FINGER}"/></geometry></collision>
      <xacro:box_inertial name="finger_${side}" m="${hw['mass']['finger']}" x="0.014" y="0.008" z="${FINGER}" xyz="0 ${sign * 0.004} ${FZ}"/>
    </link>
    <joint name="grip_${side}" type="prismatic">   <!-- SDF: joint and link names share one namespace -->
      <parent link="tool"/>
      <child link="finger_${side}"/>
      <origin xyz="0 0 ${L3 - d6}"/>
      <axis xyz="0 ${sign} 0"/>
      <limit lower="${arm['gripper']['lower']}" upper="${arm['gripper']['upper']}" velocity="${arm['gripper']['velocity']}" effort="${hw['effort']['finger']}"/>
      <xacro:if value="${side == 'right'}"><mimic joint="grip_left" multiplier="1" offset="0"/></xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="ras_arm" params="parent">
    <joint name="base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
    </joint>

    <link name="base_link">
      <xacro:looks name="base_link" z0="0">
        <placeholder>
          <visual><origin xyz="0 0 0.004"/><geometry><cylinder radius="0.08" length="0.008"/></geometry><material name="dark"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 0 0.004"/><geometry><cylinder radius="0.08" length="0.008"/></geometry></collision>
      <xacro:box_inertial name="base_link" m="${hw['mass']['base_link']}" x="0.16" y="0.16" z="0.008" xyz="0 0 0.004"/>
    </link>

    <!-- J1 base yaw, 0 = cradle (+x) -->
    <xacro:revolute name="J1" parent="base_link" child="turret" xyz="0 0 0" axis="0 0 1"/>
    <link name="turret">
      <xacro:looks name="turret" z0="0">
        <placeholder>
          <visual><origin xyz="0 0 ${(H + 0.008) / 2}"/><geometry><cylinder radius="0.062" length="${H - 0.008}"/></geometry><material name="dark"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 0 ${(H + 0.008) / 2}"/><geometry><cylinder radius="0.062" length="${H - 0.008}"/></geometry></collision>
      <xacro:box_inertial name="turret" m="${hw['mass']['turret']}" x="0.124" y="0.124" z="${H}" xyz="0 0 ${H / 2}"/>
    </link>

    <!-- J2 shoulder pitch, from vertical, + = leaning toward the cradle -->
    <xacro:revolute name="J2" parent="turret" child="upper_arm" xyz="0 0 ${H}" axis="0 1 0"/>
    <link name="upper_arm">
      <xacro:looks name="upper_arm" z0="${H}">
        <placeholder>
          <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.03" length="0.044"/></geometry><material name="dark"/></visual>
          <visual><origin xyz="0 0 ${L1 / 2}"/><geometry><box size="0.04 0.04 ${L1}"/></geometry><material name="orange"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 0 ${L1 / 2}"/><geometry><box size="0.04 0.04 ${L1}"/></geometry></collision>
      <xacro:box_inertial name="upper_arm" m="${hw['mass']['upper_arm']}" x="0.04" y="0.04" z="${L1}" xyz="0 0 ${L1 / 2}"/>
    </link>

    <!-- J3 elbow pitch, relative to the upper arm, 0 = straight -->
    <xacro:revolute name="J3" parent="upper_arm" child="forearm" xyz="0 0 ${L1}" axis="0 1 0"/>
    <link name="forearm">
      <xacro:looks name="forearm" z0="${H + L1}">
        <placeholder>
          <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.022" length="0.044"/></geometry><material name="dark"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.022" length="0.044"/></geometry></collision>
      <xacro:box_inertial name="forearm" m="${hw['mass']['forearm']}" x="0.044" y="0.044" z="0.044" xyz="0 0 0"/>
    </link>

    <!-- J4 forearm roll -->
    <xacro:revolute name="J4" parent="forearm" child="forearm_roll" xyz="0 0 ${d4}" axis="0 0 1"/>
    <link name="forearm_roll">
      <xacro:looks name="forearm_roll" z0="${H + L1 + d4}">
        <placeholder>
          <visual><origin xyz="0 0 ${(L2 - d4) / 2}"/><geometry><box size="0.032 0.032 ${L2 - d4}"/></geometry><material name="orange"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 0 ${(L2 - d4) / 2}"/><geometry><box size="0.032 0.032 ${L2 - d4}"/></geometry></collision>
      <xacro:box_inertial name="forearm_roll" m="${hw['mass']['forearm_roll']}" x="0.032" y="0.032" z="${L2 - d4}" xyz="0 0 ${(L2 - d4) / 2}"/>
    </link>

    <!-- J5 wrist pitch: J2 + J3 + J5 = 180° points the gripper straight down -->
    <xacro:revolute name="J5" parent="forearm_roll" child="wrist" xyz="0 0 ${L2 - d4}" axis="0 1 0"/>
    <link name="wrist">
      <xacro:looks name="wrist" z0="${H + L1 + L2}">
        <placeholder>
          <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.016" length="0.044"/></geometry><material name="dark"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="0.016" length="0.044"/></geometry></collision>
      <xacro:box_inertial name="wrist" m="${hw['mass']['wrist']}" x="0.032" y="0.044" z="0.032" xyz="0 0 0"/>
    </link>

    <!-- J6 wrist roll. Axis −z: with the gripper pointing down, + J6 turns the fingers + in world yaw,
         so the fingers' world yaw = J1 + J6 = the firmware's "roll" -->
    <xacro:revolute name="J6" parent="wrist" child="tool" xyz="0 0 ${d6}" axis="0 0 -1"/>
    <link name="tool">
      <xacro:looks name="tool" z0="${H + L1 + L2 + d6}">
        <placeholder>
          <visual><origin xyz="0 0 ${(L3 - d6 - FINGER + BEYOND) / 2}"/><geometry><box size="0.026 0.026 ${L3 - d6 - FINGER + BEYOND}"/></geometry><material name="grey"/></visual>
          <visual><origin xyz="0 0 ${L3 - d6 - FINGER + BEYOND}"/><geometry><box size="0.02 0.07 0.008"/></geometry><material name="grey"/></visual>
        </placeholder>
      </xacro:looks>
      <collision><origin xyz="0 0 ${(L3 - d6 - FINGER + BEYOND) / 2}"/><geometry><box size="0.026 0.026 ${L3 - d6 - FINGER + BEYOND}"/></geometry></collision>
      <xacro:box_inertial name="tool" m="${hw['mass']['tool']}" x="0.026" y="0.07" z="${L3 - d6 - FINGER + BEYOND}" xyz="0 0 ${(L3 - d6 - FINGER + BEYOND) / 2}"/>
    </link>

    <!-- the firmware's "tip" (x, y, z, roll in MOVE / telemetry): between the fingertips -->
    <joint name="tool_tip_joint" type="fixed">
      <parent link="tool"/>
      <child link="tool_tip"/>
      <origin xyz="0 0 ${L3 - d6}"/>
    </joint>
    <link name="tool_tip"/>

    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>
  </xacro:macro>
</robot>
